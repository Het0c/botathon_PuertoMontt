{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cada hora cuenta",
  "version": "0.1.0",
  "identifier": "cl.botathon.cadahoracuenta",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Cada hora cuenta · Planificación 2026", "width": 1440, "height": 960, "minWidth": 680, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "externalBin": ["binaries/botathon-api"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"] }
}
